{
  "name": "mehfil",
  "version": "1.0.0",
  "private": true,
  "description": "Mehfil — a GenAI celebration & event planner for weddings, birthdays and community events, powered by Google Gemini and Firebase.",
  "license": "MIT",
  "author": "Bishal Roy",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch src/server/node.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build && vite build --ssr src/client/prerender.tsx --outDir dist/prerender --emptyOutDir && tsx scripts/prerender.ts",
    "build:server": "tsx scripts/build-server.ts",
    "build:vercel": "npm run build:web && tsx scripts/build-vercel.ts",
    "start": "node dist/server/node.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only auth,firestore --project demo-mehfil \"npx vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "eval": "tsx evals/run.ts",
    "eval:models": "tsx evals/models.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:size": "node scripts/check-repo-size.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "firebase": "^13.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
