{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/server",
    "src/shared",
    "scripts",
    "evals",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.rules.config.ts",
    "playwright.config.ts"
  ]
}
