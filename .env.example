# Copy to .env.local for local development. Never commit real values.
# All variables are read by the server only — nothing here is bundled into the browser.

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---------------------------
# Leave empty to run in labelled demo mode with the deterministic mock provider.
GEMINI_API_KEY=
# Optional overrides (defaults shown).
# AI_PROVIDER=gemini            # gemini | mock
# GEMINI_MODEL_SMART=gemini-3.8-flash
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# AI_MAX_RPM=12                 # per-instance Gemini call budget (stay under free-tier limits)

# --- Firebase (public web-app config; enables sign-in, cloud sync and share links) -----------
# These values are public by design; the browser key must be restricted in Google Cloud console.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
# REQUIRE_AUTH_FOR_AI=true      # defaults to true when Firebase is configured

# --- Server ----------------------------------------------------------------------------------
# PORT=8787
# LOG_LEVEL=info                # debug | info | warn | error
